#!/usr/bin/env bash
# 提交后自动打上对应的 git tag
VERSION=$(node -e "import('node:fs').then(fs => { const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8')); console.log(pkg.version); })")
TAG_NAME="v${VERSION}"
if [ -n "$VERSION" ] && ! git rev-parse "$TAG_NAME" >/dev/null 2>&1; then
  git tag -a "$TAG_NAME" -m "Release $TAG_NAME"
  echo "[post-commit] 已自动打上本地标签: $TAG_NAME"
fi
