{
  "name": "homepage",
  "private": true,
  "version": "0.1.1",
  "description": "自托管仪表盘（Go 后端 + React 前端）",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.19.0 <26",
    "pnpm": ">=9.0.0 <11"
  },
  "scripts": {
    "typecheck": "pnpm --filter @homepage/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "build": "pnpm --filter @homepage/web build",
    "dev": "pnpm --filter @homepage/web dev",
    "start": "cd apps/api && go run ./cmd/homepage-api",
    "clean": "pnpm --filter @homepage/web clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "3.2.4"
  }
}
