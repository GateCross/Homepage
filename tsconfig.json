{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "eslint.config.js",
    "vitest.config.ts",
    "apps/web/vitest.projects.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist",
    "**/build",
    "coverage"
  ]
}
