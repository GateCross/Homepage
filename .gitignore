# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
*.tsbuildinfo
.turbo/

# Go 构建产物（go build 默认输出，勿提交）
apps/api/homepage-api
*.exe
*.test
*.out

# 测试与覆盖率
coverage/
.vitest/
*.lcov
# go test -coverprofile 常以无扩展名的 cover 落在包目录，一并忽略
apps/api/cover

# 环境与本地密钥（运行时 config 可挂载，但不得提交密钥）
.env
.env.*
!.env.example

# 运行时配置与本地资产（部署时挂载，不入库；根目录锚定，避免同名子目录误伤）
/config/

# 日志与临时文件
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
.cache/

# 编辑器与系统
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# 可选本地覆盖
*.local
.scratch/*
.claude/*

# git worktrees
.worktrees/
.kiro/*